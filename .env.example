# Token von @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Deine Telegram-User-ID (mehrere mit Komma). Leer lassen, /start schicken, ID wird angezeigt.
ALLOWED_USER_IDS=
# Zielordner = Syncthing-Ordner, der mit dem Handy geteilt ist
DOWNLOAD_DIR=/home/pi/Sync/Mediathek
# Temp-Ordner außerhalb des Sync-Ordners
TEMP_DIR=/home/pi/.cache/mediathek-bot
# Maximale Auflösung (720 spart Speicher, 1080 für volle Qualität)
MAX_HEIGHT=720
# Deutsche Untertitel einbetten (1 = ja)
SUBTITLES=0
# Meilensteine in % mit eigener Nachricht (leer = keine)
MILESTONES=25,50,75

# ---- Pi-Überwachung (/status + Warnungen) ----
# systemd-Dienste, die laufen sollen (Komma-getrennt), z.B. syncthing@nicolas,tailscaled
SERVICES=
# Docker-Container, die laufen sollen, z.B. homeassistant,immich_server
DOCKER_CONTAINERS=
# Zusätzliche Laufwerke/Pfade (der Download-Ordner wird immer geprüft)
DISK_PATHS=/
# Warnschwellen
TEMP_WARN=75
DISK_WARN_PCT=10
# Prüfintervall in Sekunden
CHECK_INTERVAL=300

# Token von @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Deine Telegram-User-ID (mehrere mit Komma). Leer lassen, /start schicken, ID wird angezeigt.
ALLOWED_USER_IDS=
# Zielordner = Syncthing-Ordner, der mit dem Handy geteilt ist
DOWNLOAD_DIR=/home/pi/Sync/Mediathek
# Temp-Ordner außerhalb des Sync-Ordners
TEMP_DIR=/home/pi/.cache/mediathek-bot
# Maximale Auflösung (720 spart Speicher, 1080 für volle Qualität)
MAX_HEIGHT=720
# Deutsche Untertitel einbetten (1 = ja)
SUBTITLES=0
# Meilensteine in % mit eigener Nachricht (leer = keine)
MILESTONES=25,50,75

# ---- Pi-Überwachung (/status + Warnungen) ----
# systemd-Dienste, die laufen sollen (Komma-getrennt), z.B. syncthing@nicolas,tailscaled
SERVICES=
# Docker-Container, die laufen sollen (erkennt auch Abstürze/Neustart-Schleifen und "unhealthy")
DOCKER_CONTAINERS=
# Web-Checks name=url: erkennt Dienste, die laufen, aber nicht mehr antworten ("aufgehängt")
# z.B. homeassistant=http://localhost:8123,grafana=http://localhost:3000,motioneye=http://localhost:8765
HTTP_CHECKS=
# Zusätzliche Laufwerke/Pfade (der Download-Ordner wird immer geprüft)
DISK_PATHS=/
# Warnschwellen
TEMP_WARN=75
DISK_WARN_PCT=10
# Prüfintervall in Sekunden
CHECK_INTERVAL=300

# ---- Kamera (motionEye / ESP32-CAM) ----
# Snapshot-URL aus motionEye: Kamera-Einstellungen -> Video Streaming -> Useful URLs -> Snapshot URL
SNAPSHOT_URL=
# Falls die URL Benutzer/Passwort braucht (Basic Auth)
CAMERA_USER=
CAMERA_PASSWORD=
# Bewegungsalarm: motionEye ruft http://<Pi-IP>:WEBHOOK_PORT/motion?key=WEBHOOK_KEY auf
# Schlüssel erzeugen mit: openssl rand -hex 16   (leer = Alarm aus)
WEBHOOK_KEY=
WEBHOOK_PORT=8089
# Mindestabstand zwischen zwei Alarmen in Sekunden
MOTION_COOLDOWN=120
